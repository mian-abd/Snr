            "title": "Selected Model Id",
            "type": "string"
          },
          "strategy_id": {
            "title": "Strategy Id",
            "type": "string"
          },
          "task_signals": {
            "items": {
              "type": "string"
            },
            "title": "Task Signals",
            "type": "array"
          }
        },
        "required": [
          "strategy_id",
          "priority",
          "selected_model_id",
          "eligible_model_ids",
          "task_signals",
          "reason"
        ],
        "title": "RoutingDecision",
        "type": "object"
      },
      "RoutingPriority": {
        "enum": [
          "cost",
          "quality",
          "latency",
          "balanced"
        ],
        "title": "RoutingPriority",
        "type": "string"
      },
      "RoutingStrategySummary": {
        "additionalProperties": false,
        "properties": {
          "accuracy": {
            "title": "Accuracy",
            "type": "number"
          },
          "accuracy_when_served": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy When Served"
          },
          "attempted": {
            "title": "Attempted",
            "type": "integer"
          },
          "correct": {
            "title": "Correct",
            "type": "integer"
          },
          "failed": {
            "title": "Failed",
            "type": "integer"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "mean_latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Latency Ms"
          },
          "selected_model_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Selected Model Counts",
            "type": "object"
          },
          "strategy_id": {
            "title": "Strategy Id",
            "type": "string"
          },
          "successful": {
            "title": "Successful",
            "type": "integer"
          },
          "total_cost_usd": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Cost Usd"
          }
        },
        "required": [
          "strategy_id",
          "label",
          "selected_model_counts",
          "attempted",
          "successful",
          "failed",
          "correct",
          "accuracy",
          "accuracy_when_served",
          "mean_latency_ms",
          "total_cost_usd"
        ],
        "title": "RoutingStrategySummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
