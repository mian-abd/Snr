        "title": "RoutingDashboard",
        "type": "object"
      },
      "RoutingDecision": {
        "additionalProperties": false,
        "properties": {
          "eligible_model_ids": {
            "items": {
              "type": "string"
            },
            "title": "Eligible Model Ids",
            "type": "array"
          },
          "priority": {
            "$ref": "#/components/schemas/RoutingPriority"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
