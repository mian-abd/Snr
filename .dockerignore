# Only what the image needs enters the build context; secrets and local state stay out.
*
!backend/
!data/
!frontend/

backend/.venv
backend/.env
**/.env
**/.env.*
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
data/local
frontend/node_modules
frontend/dist
frontend/playwright-report
frontend/test-results
frontend/*.local.mjs
